msgstr "После шестого значка"

#. Levels describe shared item upgrades, not Pokémon levels.
msgctxt "page:Upgrade levels"
msgid "Upgrade levels"
msgstr "Уровни улучшения"

#. Levels describe shared item upgrades, not Pokémon levels.
msgctxt "page:Where to upgrade"
msgid "Where to upgrade"
msgstr "Где улучшить"

#. Preserve prerequisites, shared levels and exact cost ranges.
msgctxt "page:Black Belt (Vanilla or Difficult); trade Everstones equal to the target level."
msgid "Black Belt (Vanilla or Difficult); trade Everstones equal to the target level."
msgstr "Чёрный пояс (обычная или сложная сложность); число камней вечности равно новому уровню."

#. Preserve prerequisites, shared levels and exact cost ranges.
msgctxt "page:Black Belt (Expert or Insane); trade Everstones equal to the target level."
msgid "Black Belt (Expert or Insane); trade Everstones equal to the target level."
msgstr "Чёрный пояс (экспертная или безумная сложность); число камней вечности равно новому уровню."

#. Preserve prerequisites, shared levels and exact cost ranges.
msgctxt "page:Defeat the Black Belt; levels 2–7 cost 2–7 Star Pieces, levels 8–10 cost 2–4 Comet Shards. All six Power items share the level."
msgid "Defeat the Black Belt; levels 2–7 cost 2–7 Star Pieces, levels 8–10 cost 2–4 Comet Shards. All six Power items share the level."
msgstr "Победить Чёрного пояса; уровни 2–7 стоят 2–7 осколков звезды, уровни 8–10 — 2–4 куска кометы. Уровень общий для всех шести силовых предметов."

#. Preserve prerequisites, shared levels and exact cost ranges.
msgctxt "page:Statue of Regi rewards one level below level 10; further upgrades cost Big Nuggets equal to the target level. Luck Incense shares the level."
msgid "Statue of Regi rewards one level below level 10; further upgrades cost Big Nuggets equal to the target level. Luck Incense shares the level."
msgstr "«Статуя Реджи» повышает уровень на один, пока он ниже 10; дальнейшие улучшения стоят столько мегасамородков, каков новый уровень. Уровень общий с Ароматом удачи."

#. Preserve prerequisites, shared levels and exact cost ranges.
msgctxt "page:Exp. Millionaire rewards level 2; levels 3–7 cost 3–7 Big Pearls, levels 8–10 cost 2–4 Pearl Strings."
msgid "Exp. Millionaire rewards level 2; levels 3–7 cost 3–7 Big Pearls, levels 8–10 cost 2–4 Pearl Strings."
msgstr "«Опытный миллионер» даёт уровень 2; уровни 3–7 стоят 3–7 крупных жемчужин, уровни 8–10 — 2–4 нити жемчуга."

#. Rewards may include bundles and alternative quantities.
msgctxt "page:Possible rewards"
msgid "Possible rewards"
msgstr "Возможные награды"

#. Identifies the first opposing trainer.
msgctxt "page:First opponent"
msgid "First opponent"
msgstr "Первый противник"

#. Identifies the additional opposing trainer.
msgctxt "page:Second opponent"
msgid "Second opponent"
msgstr "Второй противник"

#. Shows substitutions even when their stats coincide.
msgctxt "page:Possible species"
msgid "Possible species"
msgstr "Возможные виды"

#. Preserves an unproven substitution cause.
msgctxt "page:Unknown species condition"
msgid "Unknown species condition"
msgstr "Условие смены вида неизвестно"

#. Connects each species to its selection condition.
msgctxt "page:{species}: {condition}"
msgid "{species}: {condition}"
msgstr "{species}: {condition}"

#. Any caught entry in this range unlocks substitutions.
msgctxt "page:Before registering a caught entry from National Pokédex No. 810–898"
msgid "Before registering a caught entry from National Pokédex No. 810–898"
msgstr "До регистрации пойманного покемона № 810–898 в Национальном Покедексе"

#. Any caught entry in this range unlocks substitutions.
msgctxt "page:After registering a caught entry from National Pokédex No. 810–898"
msgid "After registering a caught entry from National Pokédex No. 810–898"
msgstr "После регистрации пойманного покемона № 810–898 в Национальном Покедексе"

#. Either condition preserves the listed species.
msgctxt "page:Hard level cap disabled or Hall of Fame reached"
msgid "Hard level cap disabled or Hall of Fame reached"
msgstr "Лимит уровня отключён или уже был вход в Зал славы"

#. Both conditions are required for substitution.
msgctxt "page:Hard level cap enabled and Hall of Fame not yet reached"
msgid "Hard level cap enabled and Hall of Fame not yet reached"
msgstr "Лимит уровня включён, входа в Зал славы ещё не было"

#. Species rule: the scaled battle level reaches the threshold.
msgctxt "page:Level {level} or higher after level scaling"
msgid "Level {level} or higher after level scaling"
msgstr "Уровень после подстройки {level} и выше"

#. Species rule: the opponent and the scaled level both apply.
msgctxt "page:Against {trainer}, level {level} or higher after level scaling"
msgid "Against {trainer}, level {level} or higher after level scaling"
msgstr "Против тренера {trainer}, уровень после подстройки {level} и выше"

#. Species rule: the held item sets the form.
msgctxt "page:Form selected by the held item"
msgid "Form selected by the held item"
msgstr "Форму задаёт удерживаемый предмет"

#. Species rule: each battle draws one core.
msgctxt "page:Core chosen at random"
msgid "Core chosen at random"
msgstr "Ядро выбирается случайно"

#. Species rule: party names fix the core.
msgctxt "page:Core fixed by the trainer's party"
msgid "Core fixed by the trainer's party"
msgstr "Ядро определяется командой тренера"

#. Species rule: the scaled battle level lies in the range.
msgctxt "page:Level {level} to {last} after level scaling"
msgid "Level {level} to {last} after level scaling"
msgstr "Уровень после подстройки {level}–{last}"

#. Species rule: the badge count and the scaled level both apply.
msgctxt "page:With {badges} badges or more, level {level} or higher after level scaling"
msgid "With {badges} badges or more, level {level} or higher after level scaling"
msgstr "Значков не меньше {badges}, уровень после подстройки {level} и выше"

#. Species rule: the badge count and the scaled level range both apply.
msgctxt "page:With {badges} badges or more, level {level} to {last} after level scaling"
msgid "With {badges} badges or more, level {level} to {last} after level scaling"
msgstr "Значков не меньше {badges}, уровень после подстройки {level}–{last}"

#. Species rule: the Hall of Fame and the scaled level both apply.
msgctxt "page:After the Hall of Fame, level {level} or higher after level scaling"
msgid "After the Hall of Fame, level {level} or higher after level scaling"
msgstr "После Зала славы, уровень после подстройки {level} и выше"

#. Species rule: the Hall of Fame and the scaled level range both apply.
msgctxt "page:After the Hall of Fame, level {level} to {last} after level scaling"
msgid "After the Hall of Fame, level {level} to {last} after level scaling"
msgstr "После Зала славы, уровень после подстройки {level}–{last}"

#. Species rule: the condition applies to this species variant.
msgctxt "page:{condition} (evolved from {species})"
msgid "{condition} (evolved from {species})"
msgstr "{condition} (эволюция вида {species})"

#. Species rule: only the rematch command evolves members.
msgctxt "page:{condition} (rematch only)"
msgid "{condition} (rematch only)"
msgstr "{condition} (только в повторном бою)"

#. Species rule: the player's highest level selects the scaled battle.
msgctxt "page:{condition} (with a party member at level {party_level} or higher)"
msgid "{condition} (with a party member at level {party_level} or higher)"
msgstr "{condition} (если в команде есть покемон уровня {party_level} и выше)"

#. Clarify unit payouts for quantity sales.
msgctxt "page:Per item"
msgid "Per item"
msgstr "За штуку"

#. Separate rotating offers from simultaneous rewards.
msgctxt "page:Offer varies with the date"
msgid "Offer varies with the date"
msgstr "Предложение зависит от даты"

#. State frequency and progression without implying player choice.
msgctxt "page:Once per day; offer depends on story progress"
msgid "Once per day; offer depends on story progress"
msgstr "Раз в день; предложение зависит от сюжетного прогресса"

#. Identify the ordinary unit payout.
msgctxt "page:Without the birthday discount"
msgid "Without the birthday discount"
msgstr "Без скидки в день рождения"

#. Identify the reduced unit payout.
msgctxt "page:Birthday discount active"
msgid "Birthday discount active"
msgstr "Действует скидка в день рождения"

#. no game string: neutral indoor map name from its section and map type
msgctxt "page:{location} · Interior"
msgid "{location} · Interior"
msgstr "{location} · Помещение"

#. no game string: neutral underground map name from its section and map type
msgctxt "page:{location} · Underground"
msgid "{location} · Underground"
msgstr "{location} · Подземная часть"

#. no game string: neutral map name without a more specific kind
msgctxt "page:{location} · Area"
msgid "{location} · Area"
msgstr "{location} · Область"

#. Trainer condition: allied-trainer battle mode is active; this does not describe the number of opponents.
msgctxt "page:With a battle partner"
msgid "With a battle partner"
msgstr "С напарником в бою"

#. Trainer condition: allied-trainer battle mode is inactive; this does not describe the number of opponents.
msgctxt "page:Without a battle partner"
msgid "Without a battle partner"
msgstr "Без напарника в бою"

#. Trainer condition: the story has reached the start of this battle. Includes the battle itself; does not require victory.
msgctxt "page:From the Ivory battle at Crystal Peak onward"
msgid "From the Ivory battle at Crystal Peak onward"
msgstr "Начиная с боя с Айвори на пике Кристал"

#. Trainer condition: the story has not reached the start of this battle. Do not describe the condition as a missing victory.
msgctxt "page:Before the Ivory battle at Crystal Peak"
msgid "Before the Ivory battle at Crystal Peak"
msgstr "До боя с Айвори на пике Кристал"

#. Technical record: raw predicates with their member slot, data path and complete outcome; no player-facing meaning is established.
msgctxt "page:Unresolved conditions"
msgid "Unresolved conditions"
msgstr "Нерасшифрованные условия"

#. no game string: Nominative season form label; ROM season words are inflected in dialogue.
msgctxt "page:Spring Form"
msgid "Spring Form"
msgstr "Весенняя форма"

#. no game string: Nominative season form label; ROM season words are inflected in dialogue.
msgctxt "page:Summer Form"
msgid "Summer Form"
msgstr "Летняя форма"

#. no game string: Nominative season form label; ROM season words are inflected in dialogue.
msgctxt "page:Autumn Form"
msgid "Autumn Form"
msgstr "Осенняя форма"

#. no game string: Nominative season form label; ROM season words are inflected in dialogue.
msgctxt "page:Winter Form"
msgid "Winter Form"
msgstr "Зимняя форма"

#. Identifies the stored trainer class.
msgctxt "page:Class id"
msgid "Class id"
msgstr "ID класса"

#. Stores battle AI behavior bits.
msgctxt "page:AI flags"
msgid "AI flags"
msgstr "Флаги ИИ"

#. Describes the stored party record format.
msgctxt "page:Party flags"
msgid "Party flags"
msgstr "Флаги команды"

#. Locates stored party data in the ROM.
msgctxt "page:Party offset"
msgid "Party offset"
msgstr "Смещение команды"

#. Locates the trainer record in the ROM.
msgctxt "page:Record offset"
msgid "Record offset"
msgstr "Смещение записи"

#. Stores IV values or a stat spread selector.
msgctxt "page:Stored IV/spread"
msgid "Stored IV/spread"
msgstr "Сохранённые IV/распределение"

#. Identifies the stored trainer record by number.
msgctxt "page:Trainer record {n}"
msgid "Trainer record {n}"
msgstr "Запись тренера {n}"

#. Counts members in the stored party.
msgctxt "page:Stored party size"
msgid "Stored party size"
msgstr "Размер команды в записи"
