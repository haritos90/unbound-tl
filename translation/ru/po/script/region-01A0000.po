msgid "hash:03392876"
msgstr ""
"А в Национальном Покедексе:\\pВстречено покемонов: {STR_VAR_1},\\n"
"поймано: {STR_VAR_2}."

#. category: script; mode: field
#. original lines: 2, widths px: 180, 168
#: 0x01a71ee
