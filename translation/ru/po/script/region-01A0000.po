msgid "hash:c728ea78"
msgstr ""
"Прогресс Покедекса:\\pВстречено покемонов: {STR_VAR_1},\\nпоймано: "
"{STR_VAR_2}.\\p{FONT 02}Оценка профессора Лога:"

#. category: script; mode: field
#. original lines: 3, widths px: 162, 97, 86
#: 0x01a71aa
