msgid "hash:fe81fc1a"
msgstr "Ого!\\nДа ты крепкий орешек!\\p"

#. category: data-table; mode: field
#. original lines: 3, widths px: 111, 117, 0
#: 0x0458618
msgctxt "hash:93875804"
msgid "hash:93875804"
msgstr "Такой приём?\\nОтличная стратегия!\\p"

#. category: data-table; mode: field
#. original lines: 3, widths px: 59, 133, 0
#: 0x0458644
msgctxt "hash:83919c52"
msgid "hash:83919c52"
msgstr "Здорово!\\nВот это открытие!\\p"

#. category: data-table; mode: field
#. original lines: 3, widths px: 152, 141, 0
#: 0x0458668
msgctxt "hash:15d0aebd"
msgid "hash:15d0aebd"
msgstr "Ого! Выпустить этого покемона\\nв такой ситуации?\\p"

#. category: data-table; mode: field
#. original lines: 3, widths px: 75, 159, 0
#: 0x04586a0
msgctxt "hash:4bc15e5b"
msgid "hash:4bc15e5b"
msgstr "Этот покемон…\\nКак хорошо его вырастили!\\p"

#. category: data-table; mode: field
#. original lines: 3, widths px: 52, 150, 0
#: 0x04586d0
msgctxt "hash:7bca2ad1"
msgid "hash:7bca2ad1"
msgstr "Вот оно!\\nСейчас это верный ход!\\p"

#. category: data-table; mode: field
#. original lines: 3, widths px: 84, 138, 0
#: 0x04586f8
msgctxt "hash:0351fce2"
msgid "hash:0351fce2"
msgstr "Потрясающе!\\nТак тоже можно сражаться?\\p"

#. category: data-table; mode: field
#. original lines: 3, widths px: 160, 99, 0
#: 0x0458724
msgctxt "hash:75924028"
msgid "hash:75924028"
msgstr "Как ты точно выбираешь момент\\nдля замены покемонов!\\p"
