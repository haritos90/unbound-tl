msgid "hash:9d6003cb"
msgstr "Странное яйцо покемона,\\nнайденное в Дневном уходе."

#. category: data-table; mode: field
#. original lines: 2, widths px: 188, 140
#: 0x0419aa2
msgctxt "hash:35659c11"
msgid "hash:35659c11"
msgstr "Удивительно необычное яйцо\\nпокемона из чудесного места."

#. category: data-table; mode: field
#. original lines: 2, widths px: 183, 138
#: 0x0419ade
msgctxt "hash:f118afc3"
msgid "hash:f118afc3"
msgstr "Странное яйцо покемона от\\nстарушки с горячих источников."

#. category: data-table; mode: field
#. original lines: 2, widths px: 176, 60
#: 0x0419b18
