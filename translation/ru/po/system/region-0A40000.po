#: 0x0a4559e
msgctxt "hash:a582a04d"
msgid "hash:a582a04d"
msgstr "Я ищу всякие миленькие аксессуары."

#. category: data-table; mode: field
#. original lines: 1, widths px: 137
#: 0x0a455cb
msgctxt "hash:9d930302"
msgid "hash:9d930302"
msgstr "Вот бы нарядиться!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 178, 66
#: 0x0a455e4
msgctxt "hash:5fee4b23"
msgid "hash:5fee4b23"
msgstr "Найдёшь милые аксессуары -\\nдай мне знать!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 147, 54
#: 0x0a45612
msgctxt "hash:028b12bf"
msgid "hash:028b12bf"
msgstr "Мой принцип - носить мини-юбки!"

#. category: code; mode: field
#. original lines: 1, widths px: 105
#: 0x0a45639
msgctxt "hash:e46b4a33"
msgid "hash:e46b4a33"
msgstr "А какой принцип у тебя?"

#. category: data-table; mode: field
#. original lines: 1, widths px: 149
#: 0x0a4564d
msgctxt "hash:19c859b8"
msgid "hash:19c859b8"
msgstr "Мини-юбки - это вещь!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 58
#: 0x0a4566a
msgctxt "hash:d082872d"
msgid "hash:d082872d"
msgstr "Поехали!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 188, 26
#: 0x0a45675
msgctxt "hash:4bb9777d"
msgid "hash:4bb9777d"
msgstr "Как можно обижать\\nбедную маленькую девочку?"

#. category: data-table; mode: field
#. original lines: 1, widths px: 114
#: 0x0a4569d
msgctxt "hash:153ab02e"
msgid "hash:153ab02e"
msgstr "А нечего зевать!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 148
#: 0x0a456b2
msgctxt "hash:a498f745"
msgid "hash:a498f745"
msgstr "Море, моё прекрасное море!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 155, 115
#: 0x0a456cd
msgctxt "hash:bac8fd42"
msgid "hash:bac8fd42"
msgstr "Я хочу стать большим человеком.\\nБольшим, как море!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 94, 150
#: 0x0a456ff
msgctxt "hash:3b2bd8df"
msgid "hash:3b2bd8df"
msgstr "О… я их слышу…\\pСлышу шум волн…"

#. category: data-table; mode: field
#. original lines: 2, widths px: 160, 159
#: 0x0a4572b
msgctxt "hash:79496c1c"
msgid "hash:79496c1c"
msgstr "Я моряк из моряков!\\nЯ родился в открытом море!"

#. category: data-table; mode: field
#. original lines: 3, widths px: 59, 184, 102
#: 0x0a45766
msgctxt "hash:1316cb89"
msgid "hash:1316cb89"
msgstr "Ик… Буэ…\\pСтоит мне сойти на сушу -\\nи меня мутит без качки…"

#. category: data-table; mode: field
#. original lines: 2, widths px: 168, 128
#: 0x0a457a6
msgctxt "hash:66ec5875"
msgid "hash:66ec5875"
msgstr "Меня баюкали волны!\\nМоре было мне матерью!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 186, 43
#: 0x0a457db
msgctxt "hash:1bb29231"
msgid "hash:1bb29231"
msgstr "Давай! Налетай! Я выдержу!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 199
#: 0x0a45805
msgctxt "hash:b9590d98"
msgid "hash:b9590d98"
msgstr "Молодец! Одолеть такого громилу!"

#. category: code; mode: field
#. original lines: 2, widths px: 116, 195
#: 0x0a45828
msgctxt "hash:580a2758"
msgid "hash:580a2758"
msgstr "Ну, как тебе?\\nСлишком я здоровый для тебя?"

#. category: data-table; mode: field
#. original lines: 1, widths px: 164
#: 0x0a45861
msgctxt "hash:eecf134c"
msgid "hash:eecf134c"
msgstr "Мои покемоны закалены лесом."

#. category: data-table; mode: field
#. original lines: 1, widths px: 160
#: 0x0a45880
msgctxt "hash:9016982a"
msgid "hash:9016982a"
msgstr "Вернусь-ка я в лес."

#. category: data-table; mode: field
#. original lines: 1, widths px: 165
#: 0x0a4589e
msgctxt "hash:b3e8ee8d"
msgid "hash:b3e8ee8d"
msgstr "Вот она, сила лесов."

#. category: data-table; mode: field
#. original lines: 2, widths px: 190, 33
#: 0x0a458bd
msgctxt "hash:e051db64"
msgid "hash:e051db64"
msgstr "Неутомимый походник принимает бой!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 151, 46
#: 0x0a458e7
msgctxt "hash:d1bf9a76"
msgid "hash:d1bf9a76"
msgstr "Вот бы мне пойти по твоим стопам."

#. category: data-table; mode: field
#. original lines: 2, widths px: 190, 25
#: 0x0a4590b
msgctxt "hash:f739118b"
msgid "hash:f739118b"
msgstr "Если хочешь, можешь\\nпойти по моим стопам."

#. category: data-table; mode: field
#. original lines: 1, widths px: 137
#: 0x0a45933
msgctxt "hash:9694e851"
msgid "hash:9694e851"
msgstr "А? Где все?"

#. category: data-table; mode: field
#. original lines: 2, widths px: 189, 145
#: 0x0a4594c
msgctxt "hash:e470ae49"
msgid "hash:e470ae49"
msgstr "Я пошёл в поход, но, кажется,\\nотбился от друзей…"

#. category: data-table; mode: field
#. original lines: 1, widths px: 152
#: 0x0a45989
msgctxt "hash:ae1ee3fd"
msgid "hash:ae1ee3fd"
msgstr "Эй, ребята! Вы где?!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 158, 37
#: 0x0a459a4
msgctxt "hash:43938215"
msgid "hash:43938215"
msgstr "Сражусь с тобой,\\nкак будто я на пикнике!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 175, 60
#: 0x0a459ca
msgctxt "hash:17b77f36"
msgid "hash:17b77f36"
msgstr "Если делать вид, что это пикник,\\nпобеды не видать."

#. category: data-table; mode: field
#. original lines: 1, widths px: 40
#: 0x0a459f8
msgctxt "hash:6210cb0c"
msgid "hash:6210cb0c"
msgstr "Ла-ла-ла!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 169, 45
#: 0x0a45a00
msgctxt "hash:430a214c"
msgid "hash:430a214c"
msgstr "Кто бы ни победил, давай без обид."

#. category: data-table; mode: field
#. original lines: 1, widths px: 178
#: 0x0a45a29
msgctxt "hash:589eaf0f"
msgid "hash:589eaf0f"
msgstr "Ах ты! Я тебе это припомню!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 143
#: 0x0a45a4a
msgctxt "hash:798343df"
msgid "hash:798343df"
msgstr "Ура, ура, ура! Получилось!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 172, 47
#: 0x0a45a64
msgctxt "hash:441b3b10"
msgid "hash:441b3b10"
msgstr "Я покажу тебе,\\nкак весело сражаться."

#. category: data-table; mode: field
#. original lines: 2, widths px: 147, 111
#: 0x0a45a8e
msgctxt "hash:2426dcf7"
msgid "hash:2426dcf7"
msgstr "Ох, как вдохновляет!\\nТы лучше всех!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 167
#: 0x0a45abf
msgctxt "hash:462916a4"
msgid "hash:462916a4"
msgstr "Весело со мной сражаться, да?"

#. category: data-table; mode: field
#. original lines: 2, widths px: 196, 41
#: 0x0a45adf
msgctxt "hash:fc231c77"
msgid "hash:fc231c77"
msgstr "Никто не любит покемонов\\nбольше меня! Никто!"

#. category: data-table; mode: field
#. original lines: 3, widths px: 22, 179, 55
#: 0x0a45b0a
msgctxt "hash:24a62494"
msgid "hash:24a62494"
msgstr "Гр-р…\\pТвоя любовь к покемонам\\nсильнее моей?"

#. category: data-table; mode: field
#. original lines: 2, widths px: 171, 126
#: 0x0a45b3b
msgctxt "hash:f70ba1ed"
msgid "hash:f70ba1ed"
msgstr "Фу-ха-ха! Похоже, моя любовь\\nк покемонам сильнее твоей!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 193, 146
#: 0x0a45b71
msgctxt "hash:017e485a"
msgid "hash:017e485a"
msgstr "Ну-ка, покажи любимых покемонов.\\nНе стесняйся, давай."

#. category: data-table; mode: field
#. original lines: 1, widths px: 155
#: 0x0a45baf
msgctxt "hash:9d3bc2de"
msgid "hash:9d3bc2de"
msgstr "Ясно! Милые, но сильные."

#. category: data-table; mode: field
#. original lines: 2, widths px: 35, 147
#: 0x0a45bcb
msgctxt "hash:84e520ee"
msgid "hash:84e520ee"
msgstr "Ясно…\\pМилые, но слабоваты."

#. category: data-table; mode: field
#. original lines: 2, widths px: 177, 76
#: 0x0a45bed
msgctxt "hash:064a2cf8"
msgid "hash:064a2cf8"
msgstr "У меня есть покемоны.\\nБольше мне ничего не нужно."

#. category: data-table; mode: field
#. original lines: 2, widths px: 156, 45
#: 0x0a45c1c
msgctxt "hash:e8c0f4cb"
msgid "hash:e8c0f4cb"
msgstr "Разве у тебя не так же?\\nРазве нет?"

#. category: data-table; mode: field
#. original lines: 2, widths px: 179, 58
#: 0x0a45c43
msgctxt "hash:3787a286"
msgid "hash:3787a286"
msgstr "С моими покемонами\\nя счастлив каждый день."

#. category: data-table; mode: field
#. original lines: 4, widths px: 181, 46, 138, 61
#: 0x0a45c6e
msgctxt "hash:ca68378a"
msgid "hash:ca68378a"
msgstr "Я просчитал все возможные исходы.\\pТвои шансы на победу - 3%."

#. category: data-table; mode: field
#. original lines: 1, widths px: 180
#: 0x0a45cbc
msgctxt "hash:a6f796da"
msgid "hash:a6f796da"
msgstr "Что? Вопреки всем прогнозам!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 158, 39
#: 0x0a45cdc
msgctxt "hash:d301c9e4"
msgid "hash:d301c9e4"
msgstr "Тебе явно стоит вернуться за парту."

#. category: data-table; mode: field
#. original lines: 3, widths px: 181, 137, 181
#: 0x0a45d01
msgctxt "hash:6c8e33e5"
msgid "hash:6c8e33e5"
msgstr ""
"Я знаю сильные и слабые стороны\\nкаждого покемона.\\pШансы не в твою "
"пользу."

#. category: data-table; mode: field
#. original lines: 1, widths px: 150
#: 0x0a45d5e
msgctxt "hash:7953d092"
msgid "hash:7953d092"
msgstr "Хм… Надо больше заниматься."

#. category: data-table; mode: field
#. original lines: 2, widths px: 149, 127
#: 0x0a45d79
msgctxt "hash:0417ee81"
msgid "hash:0417ee81"
msgstr "Ты лишь цифра в статистике -\\nвсё в пределах нормы."

#. category: data-table; mode: field
#. original lines: 1, widths px: 191
#: 0x0a45dad
msgctxt "hash:fa4058da"
msgid "hash:fa4058da"
msgstr "Моему интеллекту ты не ровня."

#. category: data-table; mode: field
#. original lines: 2, widths px: 153, 125
#: 0x0a45dd0
msgctxt "hash:67132fbf"
msgid "hash:67132fbf"
msgstr "Ты явно в 97-м процентиле.\\nВпечатляет."

#. category: data-table; mode: field
#. original lines: 2, widths px: 193, 27
#: 0x0a45e04
msgctxt "hash:3bf224a6"
msgid "hash:3bf224a6"
msgstr "Ещё один бой для анализа и выводов."

#. category: data-table; mode: field
#. original lines: 2, widths px: 176, 67
#: 0x0a45e2d
msgctxt "hash:c43d6e16"
msgid "hash:c43d6e16"
msgstr "Стремись к образу жизни туриста!"

#. category: data-table; mode: field
#. original lines: 3, widths px: 99, 180, 27
#: 0x0a45e5b
msgctxt "hash:8efaad8b"
msgid "hash:8efaad8b"
msgstr "Ну же, ну же!\\nБери пример с того, как я живу!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 176, 55
#: 0x0a45e93
msgctxt "hash:03158b86"
msgid "hash:03158b86"
msgstr "Видишь? Тебе ведь нравится,\\nкак я живу?"

#. category: data-table; mode: field
#. original lines: 2, widths px: 183, 106
#: 0x0a45ebe
msgctxt "hash:0c167292"
msgid "hash:0c167292"
msgstr "Здорово!\\nДалековато отсюда до гор!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 100, 90
#: 0x0a45ef3
msgctxt "hash:2378377a"
msgid "hash:2378377a"
msgstr "У меня сенная лихорадка…\\pА-а-а-а-АПЧХИ!!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 126
#: 0x0a45f15
msgctxt "hash:636cd49e"
msgid "hash:636cd49e"
msgstr "Ха-ха! Давай ещё!"

#. category: data-table; mode: field
#. original lines: 3, widths px: 52, 183, 83
#: 0x0a45f2c
msgctxt "hash:76596ddd"
msgid "hash:76596ddd"
msgstr "Эге-гей!\\pТы - гора у меня на пути, верно?"

#. category: data-table; mode: field
#. original lines: 2, widths px: 180, 78
#: 0x0a45f68
msgctxt "hash:9fb2d915"
msgid "hash:9fb2d915"
msgstr "Гр-р-р…\\nМоя победа канула в расщелину…"

#. category: data-table; mode: field
#. original lines: 2, widths px: 138, 131
#: 0x0a45f98
msgctxt "hash:ff18f841"
msgid "hash:ff18f841"
msgstr "Я-ху-у-у-у! Я-ху-у-у-у-у!\\nВнемли моему победному кличу!"

#. category: data-table; mode: field
#. original lines: 3, widths px: 187, 175, 169
#: 0x0a45fc8
msgctxt "hash:d02df754"
msgid "hash:d02df754"
msgstr ""
"Эти тупые охранники не дают мне\\nспокойно гонять тут на байке…\\pСорву "
"злость на тебе!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 164
#: 0x0a4602a
msgctxt "hash:b07349fc"
msgid "hash:b07349fc"
msgstr "Что?! У байка кончился бензин!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 89
#: 0x0a46048
msgctxt "hash:364fb34d"
msgid "hash:364fb34d"
msgstr "Глотай пыль, неумёха!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 187
#: 0x0a46059
msgctxt "hash:1d6bb26a"
msgid "hash:1d6bb26a"
msgstr "После боя давай погоняем!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 78
#: 0x0a4607b
msgctxt "hash:50b684b9"
msgid "hash:50b684b9"
msgstr "Не-е-е-ет! Мама!"

#. category: data-table; mode: field
#. original lines: 3, widths px: 186, 95, 71
#: 0x0a46089
msgctxt "hash:d07a4c34"
msgid "hash:d07a4c34"
msgstr "Вот и ещё одна жертва\\nмощи моего байка!\\lХе-хе-хе."

#. category: data-table; mode: field
#. original lines: 2, widths px: 189, 22
#: 0x0a460ca
msgctxt "hash:77958129"
msgid "hash:77958129"
msgstr "Угонишься за мной\\nна полной скорости?"

#. category: data-table; mode: field
#. original lines: 2, widths px: 24, 171
#: 0x0a460f1
msgctxt "hash:f8395b15"
msgid "hash:f8395b15"
msgstr "Тьфу…\\pМне тебя никак не победить."

#. category: data-table; mode: field
#. original lines: 3, widths px: 184, 186, 67
#: 0x0a46115
msgctxt "hash:6aafd8fb"
msgid "hash:6aafd8fb"
msgstr ""
"Раз ты не можешь победить меня\\nв бою, то в гонке на байках\\lи подавно."

#. category: data-table; mode: field
#. original lines: 2, widths px: 70, 161
#: 0x0a46166
msgctxt "hash:ac7206b7"
msgid "hash:ac7206b7"
msgstr "Переключаю передачу!\\nАтакуем на полной скорости!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 166, 35
#: 0x0a46191
msgctxt "hash:4328daac"
msgid "hash:4328daac"
msgstr "Ухожу в зону за пределами скорости!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 42
#: 0x0a461b7
msgctxt "hash:7620088a"
msgid "hash:7620088a"
msgstr "Бабах!"

#. category: data-table; mode: field
#. original lines: 3, widths px: 47, 53, 52
#: 0x0a461bf
msgctxt "hash:5daa476e"
msgid "hash:5daa476e"
msgstr "Давай!\\pПомчимся!\\pВместе!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 156
#: 0x0a461dd
msgctxt "hash:1139b17c"
msgid "hash:1139b17c"
msgstr "Стой! Не бросай меня!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 95
#: 0x0a461fa
msgctxt "hash:87d55cc6"
msgid "hash:87d55cc6"
msgstr "Фи-и-и-и-и-иниш!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 186, 61
#: 0x0a4620b
msgctxt "hash:857ac3c7"
msgid "hash:857ac3c7"
msgstr "Я лучше покатаюсь не спеша,\\nчем на полной скорости."

#. category: data-table; mode: field
#. original lines: 2, widths px: 164, 51
#: 0x0a46239
msgctxt "hash:c187f5c8"
msgid "hash:c187f5c8"
msgstr "Тебе бы ко всему относиться попроще…"

#. category: data-table; mode: field
#. original lines: 1, widths px: 102
#: 0x0a46261
msgctxt "hash:545e0700"
msgid "hash:545e0700"
msgstr "Давай без спешки."

#. category: data-table; mode: field
#. original lines: 2, widths px: 189, 71
#: 0x0a46275
msgctxt "hash:21508c0b"
msgid "hash:21508c0b"
msgstr "Я был вором, но завязал\\nи стал тренером."

#. category: data-table; mode: field
#. original lines: 1, widths px: 67
#: 0x0a462a6
msgctxt "hash:f33402a1"
msgid "hash:f33402a1"
msgstr "Сдаюсь!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 124
#: 0x0a462b3
msgctxt "hash:7cd124eb"
msgid "hash:7cd124eb"
msgstr "Сдаваться поздно!"

#. category: data-table; mode: field
#. original lines: 3, widths px: 157, 173, 61
#: 0x0a462ca
msgctxt "hash:8dc81c24"
msgid "hash:8dc81c24"
msgstr "Если у покемона талант Карманник,\\nто он что, покемон типа Вор?"

#. category: data-table; mode: field
#. original lines: 2, widths px: 185, 110
#: 0x0a46313
msgctxt "hash:a18e5ddc"
msgid "hash:a18e5ddc"
msgstr "Вот бы существовал покемон-вор.\\nС ним бы я победил!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 184, 158
#: 0x0a4634a
msgctxt "hash:bfb1b4b4"
msgid "hash:bfb1b4b4"
msgstr "Меня так и тянет\\nкрасть чужие серии побед."

#. category: data-table; mode: field
#. original lines: 4, widths px: 184, 182, 171, 87
#: 0x0a4638a
msgctxt "hash:de517568"
msgid "hash:de517568"
msgstr ""
"Я зову себя “Рисовальщиком”,\\nа с маленькой воровской маской\\lя и вовсе "
"неузнаваем."

#. category: data-table; mode: field
#. original lines: 2, widths px: 158, 182
#: 0x0a463ff
msgctxt "hash:026c48a2"
msgid "hash:026c48a2"
msgstr "Хороший политик так же немыслим,\\nкак честный вор."

#. category: data-table; mode: field
#. original lines: 2, widths px: 189, 138
#: 0x0a4643f
msgctxt "hash:66021fc0"
msgid "hash:66021fc0"
msgstr "Мы, воришки, знаем: увести\\nчужую серию можно по-разному."

#. category: data-table; mode: field
#. original lines: 2, widths px: 193, 106
#: 0x0a4647c
msgctxt "hash:bb1b2f39"
msgid "hash:bb1b2f39"
msgstr "Это я построил\\nвсе здания в округе."

#. category: data-table; mode: field
#. original lines: 2, widths px: 168, 127
#: 0x0a464b3
msgctxt "hash:8f92b302"
msgid "hash:8f92b302"
msgstr "Моя мечта - построить здание\\nвыше горы!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 125, 90
#: 0x0a464ea
msgctxt "hash:30dfb10b"
msgid "hash:30dfb10b"
msgstr "Ну, что скажешь? Круто, а?"

#. category: data-table; mode: field
#. original lines: 1, widths px: 82
#: 0x0a46512
msgctxt "hash:5c243ebb"
msgid "hash:5c243ebb"
msgstr "Пущу тебя на лом."

#. category: data-table; mode: field
#. original lines: 1, widths px: 149
#: 0x0a46522
msgctxt "hash:ac15c327"
msgid "hash:ac15c327"
msgstr "Думай экологично. Береги природу."

#. category: data-table; mode: field
#. original lines: 1, widths px: 94
#: 0x0a4653e
msgctxt "hash:5ef66261"
msgid "hash:5ef66261"
msgstr "Пущу тебя в переработку."

#. category: data-table; mode: field
#. original lines: 2, widths px: 87, 155
#: 0x0a46550
msgctxt "hash:8eb4f08e"
msgid "hash:8eb4f08e"
msgstr "С дороги!\\nМне надо развозить заказы!"

#. category: data-table; mode: field
#. original lines: 3, widths px: 163, 24, 147
#: 0x0a4657d
msgctxt "hash:f600bd87"
msgid "hash:f600bd87"
msgstr "Каждый день столько доставок…\\pУ меня все мышцы ноют!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 184, 86
#: 0x0a465bb
msgctxt "hash:c199274a"
msgid "hash:c199274a"
msgstr "Что? Тебя тоже\\nкуда-нибудь доставить?"

#. category: data-table; mode: field
#. original lines: 2, widths px: 165, 160
#: 0x0a465ec
msgctxt "hash:539a1427"
msgid "hash:539a1427"
msgstr "Рыба, рыба, рыба - вот моё дело!\\nВсю выловлю!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 53, 115
#: 0x0a4662a
msgctxt "hash:9ff920b4"
msgid "hash:9ff920b4"
msgstr "Ой-ой! Сорвалась рыбка!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 48, 158
#: 0x0a46649
msgctxt "hash:f7c0f14b"
msgid "hash:f7c0f14b"
msgstr "Ка-ха-ха! Я в отличной форме!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 189, 41
#: 0x0a4666e
msgctxt "hash:ee13e84e"
msgid "hash:ee13e84e"
msgstr "Приятели зовут меня\\nимператором рыбалки!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 151, 169
#: 0x0a46699
msgctxt "hash:80a0c88c"
msgid "hash:80a0c88c"
msgstr "Почему император рыбалки?\\nЭто древняя китайская легенда…"

#. category: data-table; mode: field
#. original lines: 1, widths px: 177
#: 0x0a466d5
msgctxt "hash:5c648ebf"
msgid "hash:5c648ebf"
msgstr "Сегодня опять поймал крупную рыбу!"

#. category: data-table; mode: field
#. original lines: 3, widths px: 181, 65, 73
#: 0x0a466f5
msgctxt "hash:4d313612"
msgid "hash:4d313612"
msgstr "Удочкой я владею лучше всех.\\pСмотри!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 175, 153
#: 0x0a46732
msgctxt "hash:5a1a9a37"
msgid "hash:5a1a9a37"
msgstr "Как я управляюсь с удочкой,\\nк боям отношения не имеет…"

#. category: data-table; mode: field
#. original lines: 2, widths px: 39, 95
#: 0x0a4676f
msgctxt "hash:41dd1735"
msgid "hash:41dd1735"
msgstr "Видишь? Небось впечатляет!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 181, 170
#: 0x0a46789
msgctxt "hash:15172c08"
msgid "hash:15172c08"
msgstr "С моим умением легко побеждать\\nдаже во сне."

#. category: data-table; mode: field
#. original lines: 1, widths px: 44
#: 0x0a467c9
msgctxt "hash:b9e27d2e"
msgid "hash:b9e27d2e"
msgstr "Хр-р-р-р…"

#. category: data-table; mode: field
#. original lines: 1, widths px: 54
#: 0x0a467d2
msgctxt "hash:9e9fdc39"
msgid "hash:9e9fdc39"
msgstr "Хр-р… Хр-р…"

#. category: data-table; mode: field
#. original lines: 2, widths px: 159, 115
#: 0x0a467dc
msgctxt "hash:5ad2035f"
msgid "hash:5ad2035f"
msgstr "Скажу прямо: сражаться\\nя не особо люблю."

#. category: data-table; mode: field
#. original lines: 2, widths px: 22, 142
#: 0x0a46810
msgctxt "hash:14a06755"
msgid "hash:14a06755"
msgstr "Гр-р…\\pТак обидно, что хоть плачь…"

#. category: data-table; mode: field
#. original lines: 2, widths px: 63, 94
#: 0x0a4682f
msgctxt "hash:5517f6d6"
msgid "hash:5517f6d6"
msgstr "Я победил, но…\\nменя до сих пор трясёт…"

#. category: data-table; mode: field
#. original lines: 2, widths px: 190, 140
#: 0x0a4684e
msgctxt "hash:aa7a2daf"
msgid "hash:aa7a2daf"
msgstr "Хочешь сбежать к мамочке -\\nсейчас самое время, малявка!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 30, 94
#: 0x0a4688a
msgctxt "hash:61adc07d"
msgid "hash:61adc07d"
msgstr "Уа-а! Хочу к мамочке!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 48, 64
#: 0x0a468a1
msgctxt "hash:5f8d8c40"
msgid "hash:5f8d8c40"
msgstr "Ге-хе-хе! Я же говорил!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 54, 102
#: 0x0a468b6
msgctxt "hash:b0aea575"
msgid "hash:b0aea575"
msgstr "Отлично! Сыграем!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 28, 81
#: 0x0a468d4
msgctxt "hash:4c2f9893"
msgid "hash:4c2f9893"
msgstr "Вот досада! Не дотянул!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 181
#: 0x0a468e9
msgctxt "hash:81abc5ec"
msgid "hash:81abc5ec"
msgstr "Сегодня тебе не повезло."

#. category: data-table; mode: field
#. original lines: 1, widths px: 156
#: 0x0a4690b
msgctxt "hash:27a19afb"
msgid "hash:27a19afb"
msgstr "Я бродяга-игрок!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 124
#: 0x0a46928
msgctxt "hash:1fc2fd9e"
msgid "hash:1fc2fd9e"
msgstr "Упустил такой шанс!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 156, 129
#: 0x0a4693f
msgctxt "hash:789e2de5"
msgid "hash:789e2de5"
msgstr "Я бродяга-игрок!\\nИ мне сейчас везёт!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 65, 107
#: 0x0a46975
msgctxt "hash:cc1daac4"
msgid "hash:cc1daac4"
msgstr "Азарт борьбы! Мне всё мало!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 89
#: 0x0a46996
msgctxt "hash:f3e0ad7e"
msgid "hash:f3e0ad7e"
msgstr "А ведь у меня был шанс!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 192, 63
#: 0x0a469a6
msgctxt "hash:5b69929c"
msgid "hash:5b69929c"
msgstr "В мире покемонов трусам не место!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 149, 37
#: 0x0a469d5
msgctxt "hash:79d8a7e2"
msgid "hash:79d8a7e2"
msgstr "Моя красота -\\nвот что делает меня сильной."

#. category: data-table; mode: field
#. original lines: 1, widths px: 93
#: 0x0a469f8
msgctxt "hash:86fc5ce3"
msgid "hash:86fc5ce3"
msgstr "В тебе столько красоты…"

#. category: data-table; mode: field
#. original lines: 1, widths px: 181
#: 0x0a46a0a
msgctxt "hash:226ddc3d"
msgid "hash:226ddc3d"
msgstr "Моя красота тебя сразила."

#. category: data-table; mode: field
#. original lines: 3, widths px: 170, 110, 59
#: 0x0a46a2b
msgctxt "hash:9bf3b035"
msgid "hash:9bf3b035"
msgstr "Может быть немножко больно,\\nно мы быстро закончим.\\pНе двигайся!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 46, 62
#: 0x0a46a6c
msgctxt "hash:8878b317"
msgid "hash:8878b317"
msgstr "Ой, нет! Больно же!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 35, 29
#: 0x0a46a81
msgctxt "hash:bf971cda"
msgid "hash:bf971cda"
msgstr "Вот! Готово!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 175, 35
#: 0x0a46a8e
msgctxt "hash:bbba2f92"
msgid "hash:bbba2f92"
msgstr "В последнее время\\nу меня столько забот…"

#. category: data-table; mode: field
#. original lines: 1, widths px: 166
#: 0x0a46ab5
msgctxt "hash:70df57f1"
msgid "hash:70df57f1"
msgstr "Ты лишь добавляешь мне забот…"

#. category: data-table; mode: field
#. original lines: 2, widths px: 181, 41
#: 0x0a46ad3
msgctxt "hash:72bcb30d"
msgid "hash:72bcb30d"
msgstr "С победой все заботы\\nкажутся пустяками!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 115, 168
#: 0x0a46afe
msgctxt "hash:c7163380"
msgid "hash:c7163380"
msgstr "Познай поражение…\\pУзнай, что значит сражаться…"

#. category: data-table; mode: field
#. original lines: 1, widths px: 176
#: 0x0a46b32
msgctxt "hash:c0db0c3d"
msgid "hash:c0db0c3d"
msgstr "Побеждённые тихо уползают…"

#. category: data-table; mode: field
#. original lines: 2, widths px: 162, 51
#: 0x0a46b52
msgctxt "hash:998eba51"
msgid "hash:998eba51"
msgstr "Я вижу, как ты\\nстановишься всё сильнее…"

#. category: data-table; mode: field
#. original lines: 1, widths px: 102
#: 0x0a46b79
msgctxt "hash:856a09ab"
msgid "hash:856a09ab"
msgstr "Смотри мне в глаза!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 179, 59
#: 0x0a46b8c
msgctxt "hash:bd84f030"
msgid "hash:bd84f030"
msgstr "Моя сила внушения\\nна тебя не подействовала!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 136
#: 0x0a46bb8
msgctxt "hash:44e77d40"
msgid "hash:44e77d40"
msgstr "Ты под моими чарами!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 161
#: 0x0a46bd3
msgctxt "hash:c47b5528"
msgid "hash:c47b5528"
msgstr "Я сосредоточился в тишине…"

#. category: data-table; mode: field
#. original lines: 1, widths px: 42
#: 0x0a46bf1
msgctxt "hash:8093c4a7"
msgid "hash:8093c4a7"
msgstr "…Получилось."

#. category: data-table; mode: field
#. original lines: 3, widths px: 149, 29, 40
#: 0x0a46bfa
msgctxt "hash:581518ff"
msgid "hash:581518ff"
msgstr "Закрой глаза и считай…\\pМедленно… Ещё медленнее…"

#. category: data-table; mode: field
#. original lines: 3, widths px: 24, 167, 33
#: 0x0a46c23
msgctxt "hash:982ef81f"
msgid "hash:982ef81f"
msgstr "Пф…\\pА я думала, что смогу тебя усыпить."

#. category: data-table; mode: field
#. original lines: 2, widths px: 161, 44
#: 0x0a46c4d
msgctxt "hash:4587899b"
msgid "hash:4587899b"
msgstr "Это был отсчёт до моей победы!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 58, 172
#: 0x0a46c73
msgctxt "hash:1fed7917"
msgid "hash:1fed7917"
msgstr "Мои силы!\\nВ них нет никакого обмана!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 154
#: 0x0a46c9e
msgctxt "hash:7865f044"
msgid "hash:7865f044"
msgstr "Обмана и правда нет…"

#. category: data-table; mode: field
#. original lines: 1, widths px: 122
#: 0x0a46cbb
msgctxt "hash:d03f99a4"
msgid "hash:d03f99a4"
msgstr "Вот она, психическая сила!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 104
#: 0x0a46cd2
msgctxt "hash:a3066d67"
msgid "hash:a3066d67"
msgstr "Кружись, кружись, кружись…"

#. category: data-table; mode: field
#. original lines: 2, widths px: 41, 102
#: 0x0a46ce7
msgctxt "hash:03cdd7f4"
msgid "hash:03cdd7f4"
msgstr "О-о-ох…\\pГолова кружится…"

#. category: data-table; mode: field
#. original lines: 1, widths px: 124
#: 0x0a46d03
msgctxt "hash:8c187e8d"
msgid "hash:8c187e8d"
msgstr "Голова кружится?"

#. category: data-table; mode: field
#. original lines: 2, widths px: 138, 179
#: 0x0a46d1a
msgctxt "hash:46085e18"
msgid "hash:46085e18"
msgstr "О да! Я это чувствую!\\nЯ настроен на твою волну!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 182
#: 0x0a46d55
msgctxt "hash:5f248caa"
msgid "hash:5f248caa"
msgstr "Пф! Проигрыш сбил мне ритм!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 54
#: 0x0a46d76
msgctxt "hash:346de5a3"
msgid "hash:346de5a3"
msgstr "Та-да-а-ам!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 180, 165
#: 0x0a46d80
msgctxt "hash:46523ed9"
msgid "hash:46523ed9"
msgstr "Вкладывай чувства в песни\\nот всей души, понимаешь?"

#. category: data-table; mode: field
#. original lines: 2, widths px: 163, 37
#: 0x0a46dc1
msgctxt "hash:c23b435a"
msgid "hash:c23b435a"
msgstr "Сейчас у меня на душе\\nчто-то вроде фолка."

#. category: data-table; mode: field
#. original lines: 2, widths px: 111, 53
#: 0x0a46de7
msgctxt "hash:1a16031c"
msgid "hash:1a16031c"
msgstr "Что у меня на душе? Рок!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 139
#: 0x0a46e06
msgctxt "hash:e69ca2b6"
msgid "hash:e69ca2b6"
msgstr "Начинаем сейшн!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 144, 120
#: 0x0a46e21
msgctxt "hash:cce387ec"
msgid "hash:cce387ec"
msgstr "Мечта о мировом турне…\\pКажется такой далёкой…"

#. category: data-table; mode: field
#. original lines: 2, widths px: 138, 49
#: 0x0a46e51
msgctxt "hash:fb38eda2"
msgid "hash:fb38eda2"
msgstr "Тебе явно не хватает практики."

#. category: data-table; mode: field
#. original lines: 2, widths px: 36, 186
#: 0x0a46e75
msgctxt "hash:ce53f9d9"
msgid "hash:ce53f9d9"
msgstr "Привет! Ты из моего фан-клуба?"

#. category: data-table; mode: field
#. original lines: 1, widths px: 134
#: 0x0a46e9d
msgctxt "hash:a09dd13a"
msgid "hash:a09dd13a"
msgstr "А, так ты не из фан-клуба…"

#. category: data-table; mode: field
#. original lines: 3, widths px: 46, 160, 173
#: 0x0a46eb6
msgctxt "hash:0d9bddee"
msgid "hash:0d9bddee"
msgstr "Ла-ла-ла…\\nПокемонов выпускаю -\\lвсех девчонок восхищаю!"

#. category: data-table; mode: field
#. original lines: 3, widths px: 92, 92, 53
#: 0x0a46efc
msgctxt "hash:e48da728"
msgid "hash:e48da728"
msgstr "Шард-де-бой! Шард-де-бой!\\pЙе-йе!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 53, 81
#: 0x0a46f28
msgctxt "hash:6c679a9e"
msgid "hash:6c679a9e"
msgstr "Йе-йе! Шард-де-проигрыш!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 53, 74
#: 0x0a46f41
msgctxt "hash:7746dd37"
msgid "hash:7746dd37"
msgstr "Йе-йе! Шард-де-победа!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 172
#: 0x0a46f59
msgctxt "hash:2c854ebc"
msgid "hash:2c854ebc"
msgstr "Узри мою ловкость и грацию!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 128
#: 0x0a46f78
msgctxt "hash:8d2ad03e"
msgid "hash:8d2ad03e"
msgstr "Фух! Вот это встряска!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 192, 85
#: 0x0a46f8f
msgctxt "hash:154e11f4"
msgid "hash:154e11f4"
msgstr "Узри! Мои лучшие покемоны\\nтебя ослепили!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 174, 64
#: 0x0a46fc1
msgctxt "hash:5a705dcb"
msgid "hash:5a705dcb"
msgstr "Заповедь укротителя драконов!\\nНомер один!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 117, 125
#: 0x0a46fec
msgctxt "hash:9cb82b64"
msgid "hash:9cb82b64"
msgstr "Даже проиграв, рычи!\\nРычи вместе со своим драконом!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 94, 125
#: 0x0a47019
msgctxt "hash:5199eef7"
msgid "hash:5199eef7"
msgstr "Победив, рычи!\\nРычи вместе со своим драконом!"

#. category: data-table; mode: field
#. original lines: 3, widths px: 162, 35, 52
#: 0x0a47042
msgctxt "hash:fb64e725"
msgid "hash:fb64e725"
msgstr "Смотри! Чувствуй!\\nАбсолютная сила…\\pНаверное!"

#. category: data-table; mode: field
#. original lines: 3, widths px: 138, 52, 107
#: 0x0a47071
msgctxt "hash:5b7ba1c8"
msgid "hash:5b7ba1c8"
msgstr "Звание абсолютного чемпиона…\\nнаверное!\\pЖалую его тебе!"

#. category: data-table; mode: field
#. original lines: 3, widths px: 169, 49, 52
#: 0x0a470a9
msgctxt "hash:2793f8ce"
msgid "hash:2793f8ce"
msgstr "Мне, абсолютному чемпиону,\\nпоражение неведомо…\\pНаверное!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 124
#: 0x0a470dc
msgctxt "hash:d6e012fa"
msgid "hash:d6e012fa"
msgstr "Могуч! Как дракон!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 28, 125
#: 0x0a470f3
msgctxt "hash:2758e76c"
msgid "hash:2758e76c"
msgstr "…Уф…\\pЯ хотел быть сильным…"

#. category: data-table; mode: field
#. original lines: 1, widths px: 74
#: 0x0a47110
msgctxt "hash:82ffc8aa"
msgid "hash:82ffc8aa"
msgstr "Силён я!"

#. category: data-table; mode: field
#. original lines: 2, widths px: 77, 175
#: 0x0a4711e
msgctxt "hash:bb752656"
msgid "hash:bb752656"
msgstr "Лети, лети, лети!\\nМы будем царить в этом бою!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 100
#: 0x0a4714e
msgctxt "hash:2ccd56e5"
msgid "hash:2ccd56e5"
msgstr "Мы сейчас разобьёмся!"

#. category: data-table; mode: field
#. original lines: 1, widths px: 30
#: 0x0a47161
msgctxt "hash:e5e0bb98"
msgid "hash:e5e0bb98"
msgstr "Вжух!"

