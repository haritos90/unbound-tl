msgctxt "map:7.9/npc:0/17"
msgid "map:7.9/npc:0/17"
msgstr "юноша"

#. category: script; mode: field
#. original lines: 1, widths px: 23
#: 0x07a89de
msgctxt "map:7.9/npc:0/19"
msgid "map:7.9/npc:0/19"
msgstr "барышня"

#. category: script; mode: field
#. original lines: 1, widths px: 31
#: 0x07a89e3
msgctxt "map:7.9/npc:0/18"
msgid "map:7.9/npc:0/18"
msgstr "сударь"

#. category: script; mode: field
#. original lines: 1, widths px: 20
#: 0x07a89ea
msgctxt "map:7.9/npc:0/20"
msgid "map:7.9/npc:0/20"
msgstr "сударыня"

