#. category: script; mode: field
#. original lines: 2, widths px: 30, 190
#: 0x1f04791
msgctxt "map:3.84/npc:11/0"
msgid "map:3.84/npc:11/0"
msgstr "Здравствуйте!\\pВсё для снижения параметров!"

#. category: script; mode: field
#. original lines: 2, widths px: 30, 189
#: 0x1f047ba
msgctxt "map:3.84/npc:12/0"
msgid "map:3.84/npc:12/0"
msgstr "Хуа!\\pВсё для повышения параметров!"

# source: Use городок with masculine agreement and reviewed inflections for references to the ten selected Town locations.
# source: Use деревня for Village.
