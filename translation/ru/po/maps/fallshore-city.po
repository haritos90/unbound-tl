msgid "map:3.84/sign:0/0"
msgstr "Город Фоллшор\\pСтолица водопадов Борриуса."

#. category: script; mode: field
#. original lines: 3, widths px: 147, 63, 191
#: 0x1f71301
msgctxt "map:3.84/sign:7/0"
msgid "map:3.84/sign:7/0"
msgstr "Стадион города Фоллшор\\nЛидер: Мел\\lВоплощение грации и красоты"

#. category: script; mode: field
#. original lines: 2, widths px: 113, 136
#: 0x1f7134a
