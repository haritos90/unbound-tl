msgid "map:3.1/sign:0/0"
msgstr ""
"Болото Кутс\\p{UP_ARROW}Городок Магнолия\\n{DOWN_ARROW}Городок Полдер\\l"
"{LEFT_ARROW}Пик Кристал"

#. category: script; mode: field
#. original lines: 1, widths px: 79
#: 0x1f72345
