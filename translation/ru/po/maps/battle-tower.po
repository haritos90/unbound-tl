#: 0x074b29e
msgctxt "hash:d8c0afeb"
msgid "hash:d8c0afeb"
msgstr "Городок Эпидими\\pУютный городок, окружённый горами."

#. category: script; mode: field
#. original lines: 2, widths px: 77, 182
#: 0x074b2df
msgctxt "hash:38ee353a"
msgid "hash:38ee353a"
msgstr "Город Фоллшор\\pСтолица водопадов Борриуса."

