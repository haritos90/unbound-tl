#. category: script; mode: field
#. original lines: 3, widths px: 67, 80, 75
#: 0x1f71aa1
msgctxt "map:3.62/sign:0/0"
msgid "map:3.62/sign:0/0"
msgstr ""
"Великая пустыня\\p{LEFT_ARROW} Город Дехара\\n{RIGHT_ARROW} Городок Гурун"

#. category: script; mode: field
#. original lines: 2, widths px: 84, 148
#: 0x1f71ac9
msgctxt "map:3.61/sign:0/0"
msgid "map:3.61/sign:0/0"
msgstr "Склеп Борриуса\\pЗдесь покоится король Борриус III."

