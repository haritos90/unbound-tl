msgid "map:1.99/sign:0/0"
msgstr "Лес Вивилл\\p{UP_ARROW} Городок Вивилл\\n{DOWN_ARROW} Городок Гурун"

#. category: script; mode: field
#. original lines: 8, widths px: 70, 184, 193, 86, 195, 194, 178, 66
#: 0x1f74345
msgctxt "map:1.99/sign:2/0"
msgid "map:1.99/sign:2/0"
msgstr ""
"Советы тренерам!\\pНекоторые спрятанные предметы, например еду и осколки, "
"можно найти не один раз!\\pЧем чаще вы бываете там, где спрятаны такие "
"предметы, тем выше шанс найти их снова."

#. category: script; mode: field
#. original lines: 1, widths px: 30
#: 0x1f878cd
msgctxt "map:1.99/npc:2/2"
msgid "map:1.99/npc:2/2"
msgstr "{COLOR 06}Ми-ип!"

#. category: script; mode: field
#. original lines: 1, widths px: 42
#: 0x1f878d6
msgctxt "map:1.99/npc:2/0"
msgid "map:1.99/npc:2/0"
msgstr "{COLOR 06}Оуоуоу!"

#. category: script; mode: field
#. original lines: 1, widths px: 33
#: 0x1f878e1
msgctxt "map:1.99/npc:11/0"
msgid "map:1.99/npc:11/0"
msgstr "{COLOR 06}Прасс!"

#. category: script; mode: field
#. original lines: 2, widths px: 121, 60
#: 0x1f878eb
msgctxt "map:1.99/npc:2/1"
msgid "map:1.99/npc:2/1"
msgstr "{COLOR 02}{STR_VAR_1} шустро убегает в лес."

