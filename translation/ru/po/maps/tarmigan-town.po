#. category: script; mode: field
#. original lines: 1, widths px: 65
#: 0x1edcd70
msgctxt "map:2.36/npc:8/0"
msgid "map:2.36/npc:8/0"
msgstr "{COLOR 06}Додогью-у-ун!"

#. category: script; mode: field
#. original lines: 1, widths px: 55
#: 0x1edcd7f
msgctxt "map:2.36/npc:8/1"
msgid "map:2.36/npc:8/1"
msgstr "{STR_VAR_1} исчезает."

