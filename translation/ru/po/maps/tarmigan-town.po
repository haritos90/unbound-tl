#. category: script; mode: field
#. original lines: 3, widths px: 73, 132, 113
#: 0x1f7150b
msgctxt "map:3.87/sign:0/0"
msgid "map:3.87/sign:0/0"
msgstr "Городок Тармиган\\pГородок на нагорье Тандеркэп."

#. category: script; mode: field
#. original lines: 2, widths px: 87, 193
#: 0x1f71546
msgctxt "map:3.87/sign:4/0"
msgid "map:3.87/sign:4/0"
msgstr "Особняк Тармиган\\pОбретите силу мегаэволюции!"

#. category: script; mode: field
#. original lines: 2, widths px: 105, 120
#: 0x1f7157a
msgctxt "map:3.87/sign:3/0"
msgid "map:3.87/sign:3/0"
msgstr "Лаборатория исследования снов\\pМы изучаем ваши сны."

#. category: script; mode: field
#. original lines: 2, widths px: 72, 170
#: 0x1f715a3
msgctxt "map:3.87/sign:2/1"
msgid "map:3.87/sign:2/1"
msgstr "Гостиница “Тармиган”…\\nДальше надпись слишком выцвела."

#. category: script; mode: field
#. original lines: 4, widths px: 66, 164, 198, 29
#: 0x1f715d0
msgctxt "map:3.87/sign:2/0"
msgid "map:3.87/sign:2/0"
msgstr ""
"Гостиница “Тармиган”\\pГнёздышко для неугомонных тренеров.\\pСладких снов "
"на наших роскошных кроватях!"

#. category: script; mode: field
#. original lines: 2, widths px: 138, 167
#: 0x1f71626
msgctxt "map:3.87/sign:1/1"
msgid "map:3.87/sign:1/1"
msgstr "Дверь плотно закрыта.\\nПохоже, её не открыть."

#. category: script; mode: field
#. original lines: 2, widths px: 80, 119
#: 0x1f7165f
msgctxt "map:3.87/sign:1/0"
msgid "map:3.87/sign:1/0"
msgstr "Странно.\\nДверь не заперта…"

# source: Use городок with masculine agreement and reviewed inflections for references to the ten selected Town locations.
# source: Use деревня for Village.
