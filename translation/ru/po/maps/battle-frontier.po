#: 0x1f93be5
msgctxt "map:24.0/npc:0/83"
msgid "map:24.0/npc:0/83"
msgstr "Сразиться с финальным боссом\\nмиссии “{STR_VAR_1}”?"

#. category: script; mode: field
#. original lines: 1, widths px: 86
#: 0x1f93c43
