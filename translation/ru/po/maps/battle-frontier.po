msgid "map:24.0/npc:0/50"
msgstr "{STR_VAR_1}? Хотите сразиться?"

#. category: script; mode: field
#. original lines: 2, widths px: 156, 82
#: 0x1f93b86
msgctxt "map:24.0/npc:0/60"
msgid "map:24.0/npc:0/60"
msgstr "С каким боссом миссии хотите сразиться?"

#. category: script; mode: field
#. original lines: 2, widths px: 183, 82
#: 0x1f93bb3
msgctxt "map:24.0/npc:0/75"
