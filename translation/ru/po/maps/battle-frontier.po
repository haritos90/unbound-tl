#: 0x1f93b33
msgctxt "map:24.0/npc:0/9"
msgid "map:24.0/npc:0/9"
msgstr "{STR_VAR_1}?\\nХотите отправиться туда?"

#. category: script; mode: field
#. original lines: 1, widths px: 165
#: 0x1f93b4f
msgctxt "map:24.0/npc:0/43"
msgid "map:24.0/npc:0/43"
msgstr "С кем хотите сразиться?"

#. category: script; mode: field
#. used in 6 places
#. original lines: 1, widths px: 121
#: 0x1f93b6d
