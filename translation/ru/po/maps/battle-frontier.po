#: 0x1f72011
msgctxt "map:3.3/sign:4/0"
msgid "map:3.3/sign:4/0"
msgstr "Боевая башня\\pНи одного поражения - лишь победы!"

#. category: script; mode: field
#. original lines: 2, widths px: 60, 99
#: 0x1f72038
msgctxt "map:3.3/sign:1/0"
