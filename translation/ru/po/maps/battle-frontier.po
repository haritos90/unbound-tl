msgid "map:3.3/npc:29/24"
msgstr "Ягоды"

#. category: script; mode: field
#. original lines: 1, widths px: 87
#: 0x1f6917b
msgctxt "map:3.3/npc:29/25"
msgid "map:3.3/npc:29/25"
msgstr "Уровни сложности"

#. category: script; mode: field
#. original lines: 1, widths px: 58
#: 0x1f6918c
msgctxt "map:3.3/npc:29/29"
msgid "map:3.3/npc:29/29"
msgstr "Разз-ягода"

#. category: script; mode: field
#. original lines: 1, widths px: 63
#: 0x1f69197
