#: 0x1f6a015
msgctxt "map:3.9/npc:24/4"
msgid "map:3.9/npc:24/4"
msgstr "Наживка для акул"

#. category: script; mode: field
#. original lines: 2, widths px: 169, 195
#: 0x1f70520
msgctxt "map:1.45/npc:0/15"
msgid "map:1.45/npc:0/15"
msgstr "Как увлекательно… Полагаю, сила\\nчемпиона более чем реальна."

#. category: script; mode: field
#. original lines: 4, widths px: 81, 164, 78, 89
#: 0x1f71fc6
