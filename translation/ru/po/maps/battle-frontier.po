msgid "map:3.3/sign:0/0"
msgstr ""
"Боевой рубеж\\p{UP_ARROW} Боевая башня, Боевые пески\\n{LEFT_ARROW} "
"Боевая шахта\\l{RIGHT_ARROW} Боевой цирк"

#. category: script; mode: field
