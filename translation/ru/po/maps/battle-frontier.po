msgstr "Боевые очки"

#. category: script; mode: field
#. original lines: 1, widths px: 136
#: 0x1f93a6f
msgctxt "map:24.0/npc:0/34"
msgid "map:24.0/npc:0/34"
msgstr "Пункты обмена"

#. category: script; mode: field
#. original lines: 1, widths px: 105
#: 0x1f93a88
msgctxt "map:24.0/npc:0/35"
msgid "map:24.0/npc:0/35"
msgstr "Табло результатов"

#. category: script; mode: field
#. original lines: 3, widths px: 175, 190, 125
#: 0x1f93a9c
msgctxt "map:24.0/npc:3/0"
msgid "map:24.0/npc:3/0"
msgstr ""
"Классная штука эта {COLOR 06}Карта Рубежа{COLOR 08}!\\pОна поменяла цвет "
"после моих побед над всеми Мозгами Рубежа!"

#. category: script; mode: field
#. original lines: 1, widths px: 140
#: 0x1f93afd
msgctxt "map:24.0/npc:0/0"
msgid "map:24.0/npc:0/0"
msgstr "Чем могу вам помочь?"

#. category: script; mode: field
#. original lines: 1, widths px: 155
#: 0x1f93b17
msgctxt "map:24.0/npc:0/4"
msgid "map:24.0/npc:0/4"
msgstr "Куда хотите отправиться?"

#. category: script; mode: field
#. used in 6 places
