msgctxt "map:3.81/sign:0/0"
msgid "map:3.81/sign:0/0"
msgstr ""
"Маршрут 10\\n“Осенняя река”\\p{LEFT_ARROW} Городок Тель\\n{UP_ARROW} "
"Канал Оберн\\l{RIGHT_ARROW} Город Фоллшор"

