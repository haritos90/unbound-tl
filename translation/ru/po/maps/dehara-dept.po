#. category: script; mode: field
#. original lines: 2, widths px: 107, 163
#: 0x1f717e5
msgctxt "map:10.1/sign:0/0"
msgid "map:10.1/sign:0/0"
msgstr "2 эт.: Лавка тренера\\pЛучшие предметы для тренеров!"

#. category: script; mode: field
#. original lines: 1, widths px: 101
#: 0x1f71841
msgctxt "map:10.2/sign:0/0"
msgid "map:10.2/sign:0/0"
msgstr "3 эт.: Зона эволюции"

#. category: script; mode: field
#. original lines: 1, widths px: 74
#: 0x1f71854
msgctxt "map:10.3/sign:0/0"
